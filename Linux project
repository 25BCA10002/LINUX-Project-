Linux project Code 
file management system 
#!/bin/bash

# Create a directory
mkdir -p FileProject

# Enter the directory
cd FileProject || exit

# Create first file
touch file1.txt

# Write data into file
echo "Hello Linux" > file1.txt

# Display file contents
cat file1.txt

# Create second file
touch file2.txt

# Copy file1.txt into file3.txt
cp file1.txt file3.txt

# Rename file2.txt
mv file2.txt newfile.txt

# Display final files
echo "Final Files:"
ls -l

