
#!/bin/bash

# Create project directory
mkdir -p fileproject

# Move into project directory
cd fileproject || exit

# Create first file
touch file1.txt

# Write text into file1.txt
echo "Hello Linux" > file1.txt

# Display file contents
echo "Contents of file1.txt:"
cat file1.txt

# Create second file
touch file2.txt

# Display files
echo "Files before copying:"
ls

# Copy file1.txt to file3.txt
cp file1.txt file3.txt

# Move and rename file2.txt
mv file2.txt newfile.txt

# Display final files
echo "Final Files:"
ls -l

# Remove unwanted file
rm newfile.txt

# Display files after removal
echo "Files after removal:"
ls -l

